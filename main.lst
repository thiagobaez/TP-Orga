     1                              <1> %macro mPrintf 0
     2                              <1>     sub     rsp,8
     3                              <1>     call    printf
     4                              <1>     add     rsp,8
     5                              <1> %endmacro
     6                              <1> 
     7                              <1> %macro mPuts 1
     8                              <1>     mov     rdi,%1
