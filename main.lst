    16                              <1>     sub     rsp,8
    17                              <1>     call    gets
    18                              <1>     add     rsp,8
    19                              <1> %endmacro
    20                              <1> 
    21                              <1> %macro mSscanf 3
    22                              <1>     mov     rdi,%1
    23                              <1>     mov     rsi,%2
    24                              <1>     mov     rdx,%3
    25                              <1>     sub     rsp,8
    26                              <1>     call    sscanf
    27                              <1>     add     rsp,8
    28                              <1> %endmacro
