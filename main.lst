    53                              <1> %macro mHayEspacioLibre? 2
    54                              <1>     mov    rdx,%1
    55                              <1>     imul   rdx,7
    56                              <1>     mov    rax,%2
    57                              <1>     cmp    byte[matriz+rdx+rax]," "
